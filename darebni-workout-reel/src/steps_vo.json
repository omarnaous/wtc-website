  {
   "id": "h1",
   "scene": "hook",
   "start": 2,
   "len": 36,
   "text": "Ten thousand steps a day."
  },
  {
   "id": "h2",
   "scene": "hook",
   "start": 41,
   "len": 60,
   "text": "Everyone's chasing it. But is it worth the hype?"
  },
  {
   "id": "o1",
   "scene": "origin",
   "start": 113,
   "len": 92,
   "text": "The number came from a 1965 Japanese pedometer ad."
  },
  {
   "id": "o2",
   "scene": "origin",
   "start": 208,
   "len": 37,
   "text": "Marketing, not science."
  },
  {
   "id": "s1",
   "scene": "science",
   "start": 263,
   "len": 196,
   "text": "The science? Seven thousand steps a day cut the risk of early death by 47 percent, versus two thousand."
  },
  {
   "id": "s2",
   "scene": "science",
   "start": 462,
   "len": 133,
   "text": "Dementia risk, down 38 percent. Depression symptoms, down 22."
  },
  {
   "id": "s3",
   "scene": "science",
   "start": 598,
   "len": 79,
   "text": "Past seven thousand, most benefits level off."
  },
  {
   "id": "a1",
   "scene": "age",
   "start": 696,
   "len": 92,
   "text": "Under 60? The sweet spot is eight to ten thousand."
  },
  {
   "id": "a2",
   "scene": "age",
   "start": 791,
   "len": 44,
   "text": "Over 60? Six to eight."
  },
  {
   "id": "t0",
   "scene": "tips",
   "start": 846,
   "len": 30,
   "text": "Make it fit your life."
  },
  {
   "id": "t1",
   "scene": "tips",
   "start": 879,
   "len": 79,
   "text": "One. Add a thousand steps a day, each week."
  },
  {
   "id": "t2",
   "scene": "tips",
   "start": 961,
   "len": 179,
   "text": "Two. Desk job? Walk two to five minutes every half hour. It lowers blood sugar after meals."
  },
  {
   "id": "t3",
   "scene": "tips",
   "start": 1143,
   "len": 86,
   "text": "Three. Take calls on your feet, and use the stairs."
  },
  {
   "id": "v1",
   "scene": "verdict",
   "start": 1251,
   "len": 84,
   "text": "Worth the hype? Yes. Magic number? No."
  },
  {
   "id": "v2",
   "scene": "verdict",
