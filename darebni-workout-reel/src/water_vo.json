 "lines": [
  {
   "id": "h1",
   "scene": "hook",
   "start": 2,
   "len": 33,
   "text": "The cheapest pre-workout?"
  },
  {
   "id": "h2",
   "scene": "hook",
   "start": 38,
   "len": 12,
   "text": "Water."
  },
  {
   "id": "d1",
   "scene": "drop",
   "start": 119,
   "len": 96,
   "text": "Sweat off just two percent of your body weight, and your lifts start to drop."
  },
  {
   "id": "d2",
   "scene": "drop",
   "start": 218,
   "len": 101,
   "text": "For an eighty kilo lifter, that's just one point six kilos."
  },
  {
   "id": "s1",
   "scene": "stats",
   "start": 340,
   "len": 225,
   "text": "A meta-analysis found dehydrated lifters lose five and a half percent strength, eight percent of their reps, and almost six percent power."
  },
  {
   "id": "b1",
   "scene": "bench",
   "start": 576,
   "len": 97,
   "text": "That's a hundred kilo bench turning into ninety-four and a half."
  },
  {
   "id": "b2",
   "scene": "bench",
   "start": 676,
   "len": 52,
   "text": "Same effort. Just less water."
  },
  {
   "id": "y1",
   "scene": "daily",
   "start": 743,
   "len": 24,
   "text": "So how much do you need?"
  },
  {
   "id": "y2",
   "scene": "daily",
   "start": 770,
   "len": 139,
   "text": "About three point seven liters a day for men, and two point seven for women, from drinks and food."
  },
  {
   "id": "y3",
   "scene": "daily",
   "start": 912,
   "len": 41,
   "text": "Plus whatever you sweat out in training."
  },
  {
   "id": "t0",
   "scene": "tips",
   "start": 966,
   "len": 40,
   "text": "Fix it in three steps."
  },
  {
   "id": "t1",
   "scene": "tips",
   "start": 1009,
   "len": 118,
   "text": "One. Five to seven milliliters per kilo, four hours before you train."
  },
  {
   "id": "t2",
   "scene": "tips",
   "start": 1130,
   "len": 127,
   "text": "Two. Check your pee. Pale yellow, you're ready. Dark? Drink more."
  },
  {
   "id": "t3",
   "scene": "tips",
   "start": 1260,
   "len": 130,
   "text": "Three. Weigh in before and after, and drink one and a half liters per kilo lost."
  },
  {
   "id": "e1",
   "scene": "bridge",
   "start": 1399,
   "len": 37,
   "text": "Water fuels the set."
  },
  {
   "id": "e2",
   "scene": "bridge",
   "start": 1439,
   "len": 45,
   "text": "Darreb-nee AI plans it."
  },
  {
   "id": "o1",
   "scene": "outro",
   "start": 1514,
   "len": 132,
   "text": "Want a plan built for you? Try Darreb-nee AI, free for seven days."
  }
 ],
