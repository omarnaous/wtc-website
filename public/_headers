# Cache policy for Workers Assets.
#
# Everything under public/ is served with `max-age=0, must-revalidate` by
# default, because the filenames are not content-hashed and Cloudflare cannot
# know when one changes. That meant a visitor re-validated all 26 watch
# photographs on every page view — a round trip each, for bytes they already
# had.
#
# The photography is keyed by Swatch reference and Wristbuddys variant, so a
# given URL is the same picture for good; a replacement is a new file with a
# new name. A day at the browser with a week of background revalidation behind
# it keeps that cheap without making a mistake permanent.

/products/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/instagram/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Uploaded media is served by the Worker from R2, not from here, and carries
# its own headers.
